{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "中国龙2",
  "version": "1.0.0",
  "identifier": "com.chinadragon2.game",
  "build": {
    "frontendDist": "../diy/diy-dist",
    "devUrl": "http://localhost:5556",
    "beforeDevCommand": "yarn dev:diy",
    "beforeBuildCommand": "yarn build:diy"
  },
  "app": {
    "windows": [
      {
        "title": "中国龙2",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
